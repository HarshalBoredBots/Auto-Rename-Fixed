# ── Telegram credentials ───────────────────────────────────────────────────
# Get from https://my.telegram.org/apps
API_ID=
API_HASH=

# Bot token from @BotFather
BOT_TOKEN=

# ── MongoDB ────────────────────────────────────────────────────────────────
# e.g. mongodb+srv://user:pass@cluster.mongodb.net/
MONGO_URI=
MONGO_DB_NAME=TorrentBot

# ── Storage ────────────────────────────────────────────────────────────────
DOWNLOAD_DIR=/downloads

# ── Queue limits ───────────────────────────────────────────────────────────
MAX_CONCURRENT_DOWNLOADS=1
MAX_CONCURRENT_UPLOADS=1
MAX_QUEUE_PER_USER=5

# ── aria2 RPC ──────────────────────────────────────────────────────────────
ARIA2_RPC_HOST=127.0.0.1
ARIA2_RPC_PORT=6800
# Leave empty to disable RPC authentication (fine for local/Docker use)
ARIA2_RPC_SECRET=

# ── Seeding (0 = no seeding) ───────────────────────────────────────────────
SEED_TIME=0
SEED_RATIO=0

# ── Admin ──────────────────────────────────────────────────────────────────
# Your Telegram numeric user ID
OWNER_ID=
# Dump channel — bot must be admin here (leave empty to disable)
DUMP_CHANNEL_ID=

# ── Misc ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Seconds between Telegram progress message edits (avoids FloodWait)
PROGRESS_UPDATE_INTERVAL=5
# Maximum torrent size allowed (GB)
MAX_TORRENT_SIZE_GB=20
